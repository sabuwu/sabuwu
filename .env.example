# Local binding; another project already uses 8080 on the author's machine.
WORDPRESS_BIND=127.0.0.1
WORDPRESS_PORT=8088
WORDPRESS_URL=http://localhost:8088
WORDPRESS_TITLE=Sabuwu | WordPress Portfolio
WORDPRESS_ADMIN_USER=portfolio_owner
WORDPRESS_ADMIN_EMAIL=portfolio@example.test
WORDPRESS_ADMIN_PASSWORD=
WP_ENVIRONMENT_TYPE=development
WORDPRESS_DEBUG=true
TZ=America/Fortaleza

DB_NAME=wordpress
DB_USER=wordpress
DB_HOST=database:3306
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_TABLE_PREFIX=wp_

# Empty secrets are generated once, saved in the ignored .env and private volumes.
# Supply strong values to override generation; do not commit real credentials.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# Container www-data UID/GID; match the owner of your bind-mounted repository.
APP_UID=1000
APP_GID=1000
CRON_INTERVAL=60
TRUST_REVERSE_PROXY=false
WORDPRESS_FORCE_SSL_ADMIN=false
# Optional plugins: installed when configured here or in the WordPress dashboard.
AKISMET_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=portfolio@example.test
SMTP_FROM_NAME=Sabuwu

